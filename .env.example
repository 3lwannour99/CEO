# Root Docker Compose environment template.
# Copy this file to `.env` and replace placeholder secrets before running Docker.

NODE_ENV=development
# For Render/production set:
# NODE_ENV=production
# Optional memory ceiling for smaller instances:
# NODE_OPTIONS=--max-old-space-size=512
HOST_UID=1000
HOST_GID=1000

FRONTEND_PORT=3000
BACKEND_PORT=4000
BACKEND_STUDIO_PORT=5555
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_FULL_NAME=System Admin

DATABASE_PROVIDER=postgresql
# Inventory API source mode:
# - database: read from InventoryItem after sync (default)
# - live: read fresh CounterScreen data in memory (no inventory row writes)
INVENTORY_DATA_MODE=database
COMPOSE_PROFILES=postgresql

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ceoreport
POSTGRES_PORT=5432
POSTGRES_DATABASE_URL=postgresql://admin:change_me@database:5432/ceoreport?schema=public

MYSQL_ROOT_PASSWORD=root
MYSQL_USER=admin
MYSQL_PASSWORD=12345678
MYSQL_DATABASE=ceoreport
MYSQL_PORT=3306
MYSQL_DATABASE_URL=mysql://admin:change_me@mysql:3306/ceoreport

DATABASE_URL=postgresql://admin:change_me@database:5432/ceoreport?schema=public
TEMPLATE_DB_URL=postgresql://admin:change_me@database:5432/ceoreport

INVENTORY_SYNC_ENABLED=true
INVENTORY_SYNC_INTERVAL_CRON=*/1 * * * *
INVENTORY_SYNC_BATCH_SIZE=1000
INVENTORY_SYNC_TRANSACTION_TIMEOUT_MS=30000
INVENTORY_SYNC_TRANSACTION_MAX_WAIT_MS=10000
COUNTERSCREEN_TIMEOUT_MS=30000
COUNTERSCREEN_REJECT_UNAUTHORIZED=false
COUNTERSCREEN_CACHE_TTL_SECONDS=300

NEXT_TELEMETRY_DISABLED=1
FRONTEND_WATCHPACK_POLLING=true
FRONTEND_CHOKIDAR_USEPOLLING=true
FRONTEND_CHOKIDAR_INTERVAL=1000

BACKEND_CHOKIDAR_USEPOLLING=true
BACKEND_CHOKIDAR_INTERVAL=1000
BACKEND_TSC_WATCHFILE=PriorityPollingInterval
BACKEND_TSC_WATCHDIRECTORY=RecursiveDirectoryUsingPolling
BACKEND_WATCHPACK_POLLING=true

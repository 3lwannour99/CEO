# Root Docker Compose environment template.
# Copy this file to `.env` and replace placeholder secrets before running Docker.

NODE_ENV=development
HOST_UID=1000
HOST_GID=1000

FRONTEND_PORT=3000
BACKEND_PORT=4000
BACKEND_STUDIO_PORT=5555
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ceoreport
POSTGRES_PORT=5432

DATABASE_URL=postgresql://admin:change_me@database:5432/ceoreport?schema=public
TEMPLATE_DB_URL=postgresql://admin:change_me@database:5432/ceoreport

INVENTORY_SYNC_ENABLED=true
INVENTORY_SYNC_INTERVAL_CRON=*/1 * * * *
COUNTERSCREEN_TIMEOUT_MS=30000
COUNTERSCREEN_REJECT_UNAUTHORIZED=false
COUNTERSCREEN_CACHE_TTL_SECONDS=300

NEXT_TELEMETRY_DISABLED=1
FRONTEND_WATCHPACK_POLLING=true
FRONTEND_CHOKIDAR_USEPOLLING=true
FRONTEND_CHOKIDAR_INTERVAL=1000

BACKEND_CHOKIDAR_USEPOLLING=true
BACKEND_CHOKIDAR_INTERVAL=1000
BACKEND_TSC_WATCHFILE=PriorityPollingInterval
BACKEND_TSC_WATCHDIRECTORY=RecursiveDirectoryUsingPolling
BACKEND_WATCHPACK_POLLING=true

# Backend local environment template.
# Copy this file to `.env` and replace placeholder secrets before running locally.

# Backend local environment template for running the backend outside Docker.
# Docker Compose uses the root `.env` file instead.

PORT=4000
NODE_ENV=development
# For Render/production set:
# NODE_ENV=production
# Optional memory ceiling for smaller instances:
# NODE_OPTIONS=--max-old-space-size=512
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_FULL_NAME=System Admin

DATABASE_PROVIDER=postgresql
# Inventory API source mode:
# - database: read from InventoryItem after sync (default)
# - live: read fresh CounterScreen data in memory (no inventory row writes)
INVENTORY_DATA_MODE=database
COMPOSE_PROFILES=postgresql

DATABASE_URL=postgresql://admin:change_me@localhost:5432/ceoreport?schema=public
TEMPLATE_DB_URL=postgresql://admin:change_me@localhost:5432/ceoreport
POSTGRES_DATABASE_URL=postgresql://admin:change_me@localhost:5432/ceoreport?schema=public

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ceoreport
POSTGRES_PORT=5432

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=admin
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ceoreport
MYSQL_PORT=3306
MYSQL_DATABASE_URL=mysql://admin:change_me@localhost:3306/ceoreport

INVENTORY_SYNC_ENABLED=true
INVENTORY_SYNC_INTERVAL_CRON=*/1 * * * *
INVENTORY_SYNC_BATCH_SIZE=1000
INVENTORY_SYNC_TRANSACTION_TIMEOUT_MS=30000
INVENTORY_SYNC_TRANSACTION_MAX_WAIT_MS=10000
COUNTERSCREEN_TIMEOUT_MS=30000
COUNTERSCREEN_REJECT_UNAUTHORIZED=false
COUNTERSCREEN_CACHE_TTL_SECONDS=300
ENABLE_SCHEDULED_REPORTS=false
REPORT_SNAPSHOT_CRON=0 2 * * *
